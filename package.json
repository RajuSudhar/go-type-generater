{
  "name": "go-type-generator",
  "version": "1.0.0",
  "description": "Generate Go types from OpenAPI 3.0/3.1 specifications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "go-type-gen": "bin/go-type-gen.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "prepare": "npm run build",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "openapi",
    "golang",
    "types",
    "generator",
    "swagger",
    "code-generation"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0",
  "dependencies": {
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0",
    "openapi-types": "^12.1.3",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
